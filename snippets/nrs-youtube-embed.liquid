{%- comment -%}
  Usage: {% render 'nrs-youtube-embed', id: 'xxxxxxxxxxx', start: 470 %}
{%- endcomment -%}
{%- if id != blank -%}
  {%- assign nrs_yt_src = 'https://www.youtube.com/embed/' | append: id -%}
  {%- if start != blank and start != 0 and start != '0' -%}
    {%- assign nrs_yt_src = nrs_yt_src | append: '?start=' | append: start -%}
  {%- endif -%}
  <div class="nrs-youtube-embed" style="position:relative;width:100%;max-width:800px;margin:16px auto 28px;aspect-ratio:16/9;height:auto;overflow:hidden;">
    <iframe
      src="{{ nrs_yt_src }}"
      title="{{ heading | default: 'YouTube video' | escape }}"
      style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;max-width:100%;"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      loading="lazy"
    ></iframe>
  </div>
{%- endif -%}
